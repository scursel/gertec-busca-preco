# Token de integração WebPosto (obrigatório)
# Múltiplas empresas: crie um token por empresa, usando o código como sufixo
# Formato: WEBPOSTO_TOKEN_<codigo_empresa>=<token>
# Exemplo para 2 empresas: WEBPOSTO_TOKEN_1=abc123...  WEBPOSTO_TOKEN_2=def456...
WEBPOSTO_TOKEN_1=

# Lista JSON de códigos de empresa
# Use colchetes, vírgulas: [1,2] para 2 empresas, [1] para 1
GERT_EMPRESAS=[1]

# Portas
GERT_TCP_PORT=6500
GERT_DASH_PORT=8650

# IP do servidor (use 0.0.0.0 para escutar em todas interfaces)
GERT_SERVER_IP=0.0.0.0

# Intervalos de sync (segundos)
GERT_SYNC_PRICES_SEC=300
GERT_SYNC_CATALOG_SEC=1800
GERT_GIF_ROTATION_SEC=30

# Mensagem de boas-vindas (G2S, máx 20 chars cada)
GERT_WELCOME_LINE1=CONSULTE AQUI!
GERT_WELCOME_LINE2=BEM-VINDO!

# Diretórios (opcional — default: ./logs e ./gifs)
# GERT_LOG_DIR=./logs
# GERT_GIF_DIR=./gifs

# Credenciais da interface web do terminal G2E
G2E_ADMIN_USER=admin
# Mude a senha em produção
G2E_ADMIN_PASS=admin

# URL base da API WebPosto (default: https://web.qualityautomacao.com.br/INTEGRACAO)
# WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br/INTEGRACAO
