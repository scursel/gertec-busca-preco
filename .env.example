# Token de integração WebPosto (obrigatório)
# Formato: WEBPOSTO_TOKEN_<codigo_empresa>=<token>
# Exemplo: WEBPOSTO_TOKEN_1=abc123...
WEBPOSTO_TOKEN_1=

*** Lista JSON de códigos de empresa
GERT_EMPRESAS=[1]

# Portas
GERT_TCP_PORT=6500
GERT_DASH_PORT=8650

# IP exibido nas instruções do dashboard (deixe 0.0.0.0 para auto)
GERT_SERVER_IP=0.0.0.0

# Intervalos de sync (segundos)
GERT_SYNC_PRICES_SEC=300
GERT_SYNC_CATALOG_SEC=1800
GERT_GIF_ROTATION_SEC=30

# Mensagem de boas-vindas (G2S, máx 20 chars cada)
GERT_WELCOME_LINE1=CONSULTE AQUI!
GERT_WELCOME_LINE2=BEM-VINDO!

# Diretórios
# GERT_LOG_DIR=./logs
# GERT_GIF_DIR=./gifs

# Credenciais da interface web do terminal G2E
G2E_ADMIN_USER=admin
G2E_ADMIN_PASS=***

# URL base da API WebPosto (não alterar salvo endpoint customizado)
# WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br/INTEGRACAO
